# ---- Core ----
# Absolute URL used in emails, sitemap and provider callbacks.
SITE_URL=http://localhost:3000

# ---- Payments (all optional) ----
# mock | paystack | stripe. "mock" runs the full payment path with no real money.
PAYMENT_PROVIDER=mock

# Paystack: local NGN cards, transfers and USSD.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Stripe: international cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Private delivery ----
# Signs 15-minute playback links for private lessons. Generate: openssl rand -hex 32
STREAM_SIGNING_SECRET=

# ---- Background jobs ----
# Guards POST /api/cron/digest.
CRON_SECRET=

# ---- Demo ----
# Set to false to hide the one-tap demo sign-in buttons.
DEMO_MODE=true

# ── Native Android app (see android/README.md) ──────────────────────────
# Comma-separated SHA-256 fingerprints of the Android signing certificate.
# Publishes /.well-known/assetlinks.json for verified App Links.
ANDROID_CERT_FINGERPRINTS=
# Secret for short-lived native playback grants. Required for private native video.
STREAM_SIGNING_SECRET=
# Comma-separated exact hostnames allowed as direct-video upstreams.
# New private lessons must use protected direct HTTPS media, never YouTube.
STREAM_ALLOWED_HOSTS=
